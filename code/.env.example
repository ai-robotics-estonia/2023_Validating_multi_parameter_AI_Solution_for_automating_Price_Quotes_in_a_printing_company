# Copy this file to `.env` and fill in your own values.
# Never commit the resulting .env to source control.

OPENAI_KEY=sk-replace-with-your-own-openai-key
ASSISTANT_ID=asst_replace-with-your-own-assistant-id

# MongoDB Atlas connection.
# Build your own URI from your cluster details — no real cluster host name
# is shipped with this repository.
MONGO_URI=mongodb+srv://USER:PASSWORD@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGO_DATABASE=your_database_name
MONGO_COLLECTION=your_collection_name
