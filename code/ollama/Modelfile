FROM llama3.1

SYSTEM """You are a helpful assistant with access to tools.
When appropriate, use the provided tools to answer questions."""

TOOL get_current_weather {
    "description": "Get the current weather for a location",
    "parameters": {
        "type": "object",
        "properties": {
            "location": {
                "type": "string",
                "description": "A city name"
            }
        },
        "required": ["location"]
    }
}

TEMPLATE """
{{- if .System }}
System: {{ .System }}
{{- end }}

{{- if .Tools }}
Available tools:
{{ .Tools }}
{{- end }}

{{- range $i, $m := .Messages }}
{{- if eq $m.Role "user" }}
Human: {{ $m.Content }}
{{- else if eq $m.Role "assistant" }}
Assistant: {{ $m.Content }}
{{- end }}
{{- end }}
"""

PARAMETER temperature 1
PARAMETER num_ctx 2048
